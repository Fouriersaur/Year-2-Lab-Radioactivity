import numpy as np
import matplotlib.pyplot as plt

# ==== Data (Session 3) ====
t_mm = [0, 0.38, 0.47, 0.96, 1.40, 1.94, 2.43, 3.38, 3.89]
t = np.array([x / 1000 for x in t_mm])  # mm -> m

Count = np.array([1590, 930.32, 829.44, 405.52, 177.46, 66.47, 20.54, 1.42, 1.05])
std_dev = np.array([40.46, 32.28, 30.03, 19.49, 14.83, 8.45, 5.01, 1.12, 0.95])

# ==== Exclude last two low-count points ====
t_fit = t[:-2]
Count_fit = Count[:-2]

# ==== Take natural log of counts ====
ln_Count = np.log(Count_fit)

# ==== Linear fit: ln(N) = m x + c ====
m, c = np.polyfit(t_fit, ln_Count, 1)

mu = -m
A = np.exp(c)

print(f"Slope (m) = {m:.2f}")
print(f"Intercept (c) = {c:.2f}")
print(f"Attenuation coefficient μ = {mu:.2f} m^-1")
print(f"Initial count A = {A:.2f}")

# ==== Generate smooth fit line ====
t_plot = np.linspace(0, max(t), 200)
ln_fit = m * t_plot + c
Count_fit_line = np.exp(ln_fit)

# ==== Plot ====
plt.figure(figsize=(8,6))
plt.errorbar(t, Count, yerr=std_dev, fmt='o', capsize=5, label="Data")
plt.plot(t_plot, Count_fit_line, 'r-', label="Straight Line Fit (log scale)")

plt.xlabel("Aluminium Thickness (m)")
plt.ylabel("Count Rate (counts/s)")
plt.title("Beta Absorption in Aluminium (Linear Fit on Log Plot)")
plt.yscale("log")
plt.legend()
plt.grid(True, which="both", ls="--", alpha=0.5)

plt.show()